# Vynucení LF pro textové soubory.
#
# Důvod: vygenerovaný dataset v data/.../generated/ vzniká spuštěním
# scripts/rebuild_dataset.py, a Python zapisuje konce řádků podle toho, na
# jakém OS skript běží (Windows CRLF vs. Linux/macOS LF). Bez tohoto
# nastavení vypadá každé přegenerování na jiném stroji jako přepsání všech
# ~9,8 MB dat, i když se obsahově změnilo pár set řádků.
#
# Syrové exporty z hry jsou z normalizace vyjmuté – viz pravidlo pro
# raw_sources/ na konci souboru.

*.json text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Výjimka: syrové exporty se drží byte-přesně tak, jak je dodává hra.
# Herní .txt z data/global/excel mají CRLF a nemají se normalizovat.
raw_sources/** -text

# --- Java backend (backend/) ---
# Pravidla jsou schválně omezená na backend/. Globální "*.xml text eol=lf" by
# zasáhlo i mobile_app/ (Flutter, Android), kde jsou soubory v indexu s CRLF,
# a git by je označil všechny jako změněné.
backend/**       text=auto eol=lf

# Maven Wrapper: mvnw je shell skript (LF), mvnw.cmd je dávkový soubor pro
# Windows a MUSÍ mít CRLF, jinak ho cmd.exe neumí spustit.
backend/mvnw     text eol=lf
backend/mvnw.cmd text eol=crlf
