<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot "starter parent" jako rodičovský POM.

      Co tím získáváme: v <parent> je obří <dependencyManagement> sekce, která
      pro stovky knihoven předepisuje verze, jež spolu prokazatelně fungují.
      Proto níž u závislostí NENÍ žádné <version> - dědí se odtud. Je to
      nejdůležitější důvod, proč se Spring Boot projekty nerozpadají na
      konfliktech verzí (v Pythonu bys řešil totéž pinováním v requirements.txt,
      jen bez záruky, že ta kombinace byla někým otestovaná).

      <relativePath/> (prázdné) říká: rodiče NEHLEDEJ v ../pom.xml, ber ho
      z repozitáře. Bez toho by Maven nejdřív koukal do kořene Game Helperu,
      kde žádný pom.xml není, a vypsal by varování.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>cz.libor</groupId>
    <artifactId>game-helper-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>game-helper-api</name>
    <description>REST API nad daty Diablo II: Resurrected - výpočet statů summonů</description>

    <properties>
        <!--
          Přepisuje property z rodiče. Ovlivní zdrojovou i cílovou verzi
          kompilátoru (maven.compiler.release), takže javac odmítne přeložit
          kód, který používá novější API než 21.
        -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Krok 4, oprava profilu "-Pit" (viz BACKEND_ZAPISNIK.md, "Krok 4 -
          oprava"). Vlastní property s hodnotou, kterou pak profil "it" níž
          jen PŘEPÍŠE - properties se v Mavenu mezi POM a aktivním profilem
          přepisují spolehlivě (na rozdíl od konfigurace pluginu, viz dál),
          takže je to bezpečnější místo pro přepínání "zapnuto/vypnuto" než
          <configuration> samotného pluginu.
        -->
        <surefire.excludedGroups>it</surefire.excludedGroups>
    </properties>

    <dependencies>
        <!--
          "Starter" = balík závislostí, ne knihovna. spring-boot-starter-web
          přitáhne Spring MVC, vestavěný Tomcat, Jackson (JSON) a validaci
          konfigurace. Přítomnost startovacího balíku na classpath je zároveň
          signál pro autokonfiguraci - Boot podle toho, co na classpath NAJDE,
          rozhodne, co nastartuje. Tohle je jádro celé "magie" Spring Bootu:
          není to reflexe nad tvým kódem, je to podmíněná konfigurace
          (@ConditionalOnClass) reagující na obsah classpath.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Hibernate + Spring Data JPA + HikariCP (connection pool) + správa transakcí. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation (@Valid, @Min, @NotNull) - použijeme v kroku 5 na compute request. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Flyway od verze 10 rozdělil podporu databází do samostatných modulů.
          Samotné flyway-core Postgres NEUMÍ - bez flyway-database-postgresql
          aplikace spadne při startu na "Unsupported Database: PostgreSQL".
          Častý zdroj zmatku při upgradu ze starších návodů.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
          <scope>runtime</scope>: driver je potřeba při běhu, ale ne při
          překladu - v kódu se na třídu org.postgresql.Driver nikde neodkazuješ,
          načte ji JDBC podle URL. Scope drží driver mimo compile classpath,
          takže na něm omylem nemůžeš postavit kód.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JUnit 5, AssertJ, Mockito, MockMvc, JSONassert. Jen pro testy. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Balí aplikaci do "fat jar" (executable jar) se vším, co potřebuje
              k běhu, včetně vestavěného Tomcatu. Díky tomu je nasazení
              "java -jar app.jar" - žádný aplikační server, do kterého se něco
              deployuje. Tenhle plugin taky poskytuje cíl spring-boot:run.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Krok 4: SkillRepositoryIT potřebuje běžící Postgres s daty
              z kroku 3 (viz jeho javadoc) - bez tohohle nastavení by
              "mvnw test" spadl na každém stroji, kde zrovna neběží
              "docker compose up" (PLAN_P1_SPRING_SLICE.md 7.4: "mvn test
              musí být zelený vždycky").

              <includes> je EXPLICITNÍ a zužuje výchozí vzory Surefire
              (Test*, *Test, *Tests, *TestCase) na jen *Test a *IT. Důvod:
              Surefire ve výchozím nastavení soubory *IT.java VŮBEC
              nezahrnuje (to je konvence Failsafe pluginu, který tu
              nemáme) - kdybych sem jen přidal @Tag("it") a nechal
              výchozí <includes>, SkillRepositoryIT by se nespustilo
              nikdy, ani přes "-Pit" profil níž. Do budoucna to znamená:
              testovací třídy musí končit na "Test" nebo "IT", jinak je
              mvn test tiše přeskočí.

              <excludedGroups> vylučuje testy se JUnit 5 @Tag("it") -
              to už je nezávislý mechanismus od <includes> výš, řeší
              jinou věc (KTERÉ ze zahrnutých tříd spustit, ne KTERÉ
              soubory vůbec načíst). Hodnota je {@code ${surefire.excludedGroups}}
              (property výš), NE napevno "it" - profil "it" níž property
              přepíše na prázdnou. Původně jsem tu měl "it" napevno a profil
              se snažil přepsat rovnou <excludedGroups> v <configuration> -
              to NEFUNGOVALO (viz BACKEND_ZAPISNIK.md, "Krok 4 - oprava"
              pro přesný důvod), proto teď nepřímo přes property.
            -->
            <!--
              Krok 6: baseline_raise_skeleton.json (8 referenčních případů
              pro RaiseSkeletonCalculatorTest, viz jeho javadoc a
              PLAN_P1_SPRING_SLICE.md sekce 7.3) žije v
              "scripts/tests/" - MIMO backend/ modul, protože je to
              společný soubor pro Python i Java stranu projektu (jediný
              zdroj pravdy, ne dvě kopie, které se časem rozejdou - stejný
              problém, který je zapsaný jako "otevřená otázka" v
              BACKEND_ZAPISNIK.md pro CELÝ dataset, jen tady řešený hned
              správně u JEDNOHO souboru, ať nevzniká druhý stejný případ).

              Testovací classpath ale žádnou cestu "o úroveň výš" znát
              nesmí (rozbilo by se to v Dockeru/CI, kde backend/ může být
              jediné, co je k dispozici - PLAN_P1_SPRING_SLICE.md sekce
              7.3). Řešení: soubor se PŘI BUILDU zkopíruje do
              target/test-classes, odkud ho test čte jako obyčejný
              classpath resource ("/baseline_raise_skeleton.json") - v
              repozitáři existuje jen JEDNA verze, v jednom místě.

              Fáze "generate-test-resources" běží před kompilací testů,
              takže je soubor v target/test-classes/ dřív, než
              RaiseSkeletonCalculatorTest vůbec začne. Bez <targetPath>
              (výchozí = kořen výstupního adresáře) skončí přesně na
              "/baseline_raise_skeleton.json", ne v podadresáři.

              Vědomé omezení: tohle řeší jen TENHLE jeden testovací
              soubor, ne celý duplicitní dataset (JSON v data/**/generated/
              vs. backend/src/main/resources/dataset/) - to zůstává
              otevřené do doby, kdy se bude řešit krok 7 (Docker build).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-baseline-raise-skeleton</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../scripts/tests</directory>
                                    <includes>
                                        <include>baseline_raise_skeleton.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          "mvnw test -Pit" spustí VŠECHNY testy včetně těch se štítkem
          "it" (SkillRepositoryIT). Vyžaduje běžící "docker compose up -d
          db" s naimportovanými daty z kroku 3.

          Přepisuje se PROPERTY (surefire.excludedGroups), ne přímo
          <configuration> pluginu. Zkoušel jsem to nejdřív přímo -
          <profile><build><plugins><plugin> se stejnou <configuration> a
          prázdným <excludedGroups/> uvnitř - a NEFUNGOVALO to (ověřeno,
          viz BACKEND_ZAPISNIK.md "Krok 4 - oprava"). Maven konfiguraci
          pluginu z profilu do hlavního <build> nepřepíše automaticky -
          když se stejný list existuje na obou místech, VYHRÁVÁ hlavní
          <build>, ne profil, a profilová hodnota se tiše zahodí (dalo by
          se to obejít atributem combine.self="override" na tom elementu,
          ale to je málo známý detail Maven XML mergingu, který by musel
          znát každý, kdo pom.xml příště upravuje). Properties se naproti
          tomu mezi POM a aktivním profilem přepisují VŽDY spolehlivě -
          proto se tahle hodnota nastavuje TAM, viz <properties> výš, a
          sem patří jen její přepsání na prázdno.
        -->
        <profile>
            <id>it</id>
            <properties>
                <surefire.excludedGroups></surefire.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
